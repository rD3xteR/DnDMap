<Window x:Class="DnDMap.SettingsWindow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DnDMap.SettingsWindow"
        xmlns:vm="clr-namespace:DnDMap.SettingsWindow.ViewModel"
        xmlns:ext="clr-namespace:DnDMap.Core.Extensions"
        xmlns:enums="clr-namespace:DnDMap.Core.Enums"
        mc:Ignorable="d"
        MinHeight="370" MinWidth="450"
        Title="Управление" Height="600" Width="800">
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.ColumnSpan="2" Header="Выбор карты">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2">
                    <Button Content="Обзор..." 
                            Command="{Binding BrowseMapsCommand}"
                            Padding="10,5"/>
                    <TextBlock Text="{Binding MapsPath}" 
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding MapItems}"
                         SelectedItem="{Binding SelectedMap}"
                         Margin="2"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" 
                                   TextWrapping="Wrap" 
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="30"
                                   HorizontalAlignment="Center"
                                   FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Padding="10, 5"
                        Content="Открыть карту"
                        Height="28"
                        Width="120"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenMapCommand}"/>
            </Grid>
        </GroupBox>

        <!-- Left panel - token params -->
        <GroupBox Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Header="Параметры круга" Margin="0,0,10,0">
            <StackPanel Margin="10">
                <TextBlock Text="Диаметр:" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding DiameterToChange}"
                            Minimum="20"
                            Maximum="200"
                            Margin="5"
                            MinWidth="180"/>
                    <TextBlock Text="{Binding DiameterToChange}" VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock Text="Размер существа:" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Source={ext:EnumBindingSource {x:Type enums:EntitySize}}}"
                          SelectedValue="{Binding SelectedEntitySize}"
                          Margin="0,5,0,10"/>
            </StackPanel>
        </GroupBox>

        <!-- Right panel - images list -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Галерея изображений">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Browse tokens panel -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <Button Content="Обзор..." 
                            Command="{Binding BrowseTokensCommand}"
                            Padding="10,5"/>
                    <TextBlock Text="{Binding TokensPath}" 
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"/>
                </StackPanel>

                <!-- Images list -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding TokenItems}"
                         SelectedItem="{Binding SelectedToken}"
                         Margin="5"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" 
                                           TextWrapping="Wrap" 
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="30"
                                           HorizontalAlignment="Center"
                                           FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Adding button -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить токен" 
                    Command="{Binding AddTokenCommand}" 
                    IsDefault="True" 
                    Padding="15,5"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
