<Window x:Class="DnDMap.MapWindow.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DnDMap.MapWindow.ViewModel"
        mc:Ignorable="d"
        Title="Draggable Circles" 
        WindowStyle="None"
        WindowState="Maximized"
        KeyDown="MainCanvas_KeyDown"
        Closed="Window_Closed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="Black">
        <Border ClipToBounds="True" Background="Black">
            <!-- Canvas живёт в экранных координатах: карта и токены позиционируются
                 из visibleRect/MapToScreen ядра, без RenderTransform. -->
            <Canvas x:Name="MainCanvas"
                    Background="Black"
                    MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                    MouseMove="MainCanvas_MouseMove"
                    MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                    MouseWheel="MainCanvas_MouseWheel">

                <Image Source="{Binding MapImageSource}"
                       Width="{Binding MapWidth}"
                       Height="{Binding MapHeight}"
                       Canvas.Left="{Binding MapLeft}"
                       Canvas.Top="{Binding MapTop}"
                       Stretch="Fill"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <ItemsControl ItemsSource="{Binding Tokens}"
                              Width="{Binding ActualWidth, ElementName=MainCanvas}"
                              Height="{Binding ActualHeight, ElementName=MainCanvas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TokenViewModel}">
                            <Grid Width="{Binding Diameter}" Height="{Binding Diameter}">
                                <Ellipse Fill="White"/>
                                <Ellipse Stroke="Black" StrokeThickness="3">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                    Stretch="Fill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Stroke="IndianRed" Fill="LightGray"
                                         Opacity="0.5" StrokeThickness="3"
                                         Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left, Mode=OneWay}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top, Mode=OneWay}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Canvas>
        </Border>
        
        <!-- Слой управления (наезжает на карту) -->
        <StackPanel HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    Background="Transparent">
            <Slider x:Name="ZoomSlider" 
                    Minimum="1" Maximum="3.0" 
                    Value="{Binding Zoom, Mode=OneWay}" 
                    Width="20" 
                    Height="300"
                    Orientation="Vertical"
                    TickFrequency="0.05" 
                    IsSnapToTickEnabled="False"
                    ValueChanged="ZoomSlider_ValueChanged"
                    Background="Transparent"/>
            <Button Content="Reset" 
                    Click="ResetButton_Click" 
                    Width="50" 
                    Background="#80000000" 
                    Foreground="White" 
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
