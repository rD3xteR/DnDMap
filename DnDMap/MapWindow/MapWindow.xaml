<Window x:Class="DnDMap.MapWindow.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DnDMap"
        xmlns:vm="clr-namespace:DnDMap.MapWindow.ViewModel"
        xmlns:model="clr-namespace:DnDMap.TokenModel"
        mc:Ignorable="d"
        Title="Draggable Circles" 
        WindowStyle="None"
        WindowState="Maximized"
        KeyDown="MainCanvas_KeyDown"
        Closed="Window_Closed">

    <Window.DataContext>
        <vm:MapViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="Black">
        <Border ClipToBounds="True" Background="Black">
            <Canvas x:Name="MainCanvas"
                    MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                    MouseMove="MainCanvas_MouseMove"
                    MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                    MouseWheel="MainCanvas_MouseWheel">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                        <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <ItemsControl ItemsSource="{Binding Tokens}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:Token}">
                            <Grid>
                                <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}" Fill="White"/>
                                <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}" Stroke="Black" StrokeThickness="3">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" Stretch="Fill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}" Stroke="IndianRed" Fill="LightGray"
                                         Opacity="0.5" StrokeThickness="3"
                                         Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Mode=OneWay}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y, Mode=OneWay}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <Canvas.Background>
                    <ImageBrush ImageSource="{Binding MapPath, UpdateSourceTrigger=PropertyChanged}" Stretch="Uniform"/>
                </Canvas.Background>
            </Canvas>
        </Border>
        
        <!-- Слой управления (наезжает на карту) -->
        <StackPanel HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    Background="Transparent">
            <Slider x:Name="ZoomSlider" 
                    Minimum="1" Maximum="3.0" 
                    Value="{Binding Zoom, Mode=TwoWay}" 
                    Width="20" 
                    Height="300"
                    Orientation="Vertical"
                    TickFrequency="0.05" 
                    IsSnapToTickEnabled="False"
                    ValueChanged="ZoomSlider_ValueChanged"
                    Background="Transparent"/>
            <Button Content="Reset" 
                    Click="ResetButton_Click" 
                    Width="50" 
                    Background="#80000000" 
                    Foreground="White" 
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>