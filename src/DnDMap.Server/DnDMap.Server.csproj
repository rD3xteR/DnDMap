<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <RootNamespace>DnDMap.Server</RootNamespace>
    <AssemblyName>DnDMap.Server</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnDMap.Core\DnDMap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Статика SPA внутри сборки: на планшете нет интернета и внешних CDN. -->
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="DnDMap.Server.wwwroot.index.html" />
    <EmbeddedResource Include="wwwroot\app.css" LogicalName="DnDMap.Server.wwwroot.app.css" />
    <EmbeddedResource Include="wwwroot\app.js" LogicalName="DnDMap.Server.wwwroot.app.js" />
  </ItemGroup>

</Project>
